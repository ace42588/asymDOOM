{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asymdoom.dev/schemas/state/door.schema.json",
  "title": "DoorView",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "state", "position"],
  "properties": {
    "id": { "type": "integer", "minimum": 0 },
    "state": { "type": "string", "enum": ["open", "closed", "opening", "closing", "waiting"] },
    "position": { "type": "number" },
    "x": { "type": "number" },
    "y": { "type": "number" },
    "z": { "type": "number" }
  }
}
