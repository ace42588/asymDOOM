{
  "name": "asymdoom-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test --experimental-test-isolation=none --test-concurrency=1 src/test/**/*.test.ts"
  },
  "dependencies": {
    "asymdoom-contracts": "*",
    "koffi": "^3.3.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
